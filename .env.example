# ShiftSync Environment Configuration
PORT=3001
NODE_ENV=development

# Nexconn Credentials (Server-side only)
# Get your App Key and App Secret from the Nexconn Console (https://console.nexconn.ai)
NEXCONN_APP_KEY=your_nexconn_app_key_here
NEXCONN_APP_SECRET=your_nexconn_app_secret_here
NEXCONN_API_DOMAIN=https://api.nexconn.ai

# Optional AI Key (Groq or Google Gemini free tier)
# The application functions completely offline with rule-based detection if omitted.
GEMINI_API_KEY=
GROQ_API_KEY=

